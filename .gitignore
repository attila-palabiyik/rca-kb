# Upstream checkouts and other fetched material
.cache/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local secrets and environment
.env
.env.*

# Working copies of earlier spec drafts
docs/archive/

# Raw agent logs and trajectories: kept in the tree as one archive per experiment, in archives/
runs/*/*/*/*/trial/
runs/*/*/*/*/attempts/

# The brief this work answers; kept locally
task.pdf

# Session transcripts kept inside KB snapshots: the final snapshot's are in the experiment's archive
runs/*/kb/*/*/snapshots/*/sessions/
